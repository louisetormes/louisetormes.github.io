---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import type { Post } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	data: Post['data'];
	minutes: number;
	prev?: Post;
	next?: Post;
}

const { data, minutes, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft } = data;
---

<BaseLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate}>
	<article class="post">
		<header class="narrow post-header">
			<div class="eyebrow kicker">
				{tags.length > 0 ? <a href={`/tags/${tags[0]}/`}>{tags[0]}</a> : <span>Ensaio</span>}
				{draft && <span class="draft">· rascunho</span>}
			</div>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			<div class="byline mono">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">·</span>
				<span>{minutes} min de leitura</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								atualizado em <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</div>
		</header>

		{
			heroImage && (
				<figure class="hero container">
					<Image src={heroImage} width={1040} height={520} alt="" loading="eager" />
				</figure>
			)
		}

		<div class="narrow">
			<div class="prose">
				<slot />
			</div>

			{
				tags.length > 0 && (
					<ul class="tags" aria-label="Temas">
						{tags.map((t) => (
							<li>
								<a class="tag" href={`/tags/${t}/`}>
									{t}
								</a>
							</li>
						))}
					</ul>
				)
			}

			<nav class="pager" aria-label="Outros escritos">
				{
					prev ? (
						<a class="prev" href={`/blog/${prev.id}/`}>
							<span class="eyebrow">← Anterior</span>
							<span class="pager-title">{prev.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					next ? (
						<a class="next" href={`/blog/${next.id}/`}>
							<span class="eyebrow">Próximo →</span>
							<span class="pager-title">{next.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
			</nav>
		</div>
	</article>
</BaseLayout>

<style>
	.post-header {
		padding-top: clamp(3rem, 8vw, 5.5rem);
		padding-bottom: 2.5rem;
	}
	.kicker {
		margin-bottom: 1.25rem;
		color: var(--accent);
	}
	.kicker a {
		text-decoration: none;
		color: inherit;
	}
	.draft {
		color: var(--muted);
	}
	h1 {
		font-size: clamp(2.1rem, 5.5vw, 3.1rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
	}
	.lede {
		margin: 1.1rem 0 0;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.5;
		font-style: italic;
		color: var(--muted);
		text-wrap: pretty;
	}
	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
	}
	.hero {
		margin: 0 auto 3rem;
	}
	.hero :global(img) {
		width: 100%;
		border-radius: var(--radius);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 3.5rem 0 0;
		padding: 0;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		text-decoration: none;
	}
	.pager .next {
		text-align: right;
	}
	.pager-title {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.3;
		color: var(--text);
	}
	.pager a:hover .pager-title {
		color: var(--accent);
	}
	@media (max-width: 560px) {
		.pager {
			grid-template-columns: 1fr;
		}
		.pager .next {
			text-align: left;
		}
	}
</style>
