---
import { AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<p class="copy">© {year} {AUTHOR}. Textos escritos por uma pessoa; ferramentas, às vezes, ajudam.</p>
		<ul class="links">
			{
				SOCIAL_LINKS.map((l) => (
					<li>
						<a href={l.href} target="_blank" rel="noopener noreferrer me">
							{l.label}
						</a>
					</li>
				))
			}
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 6rem;
		border-top: 1px solid var(--border);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 2rem 3rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.copy {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.links a {
		text-decoration: none;
		color: var(--muted);
	}
	.links a:hover {
		color: var(--text);
	}
</style>
