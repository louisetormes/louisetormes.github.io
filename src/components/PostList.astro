---
import type { Post } from '../utils/posts';
import { readingTime } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
	{
		posts.map((post) => (
			<li>
				<article>
					<div class="meta mono">
						<FormattedDate date={post.data.pubDate} />
						<span aria-hidden="true">·</span>
						<span>{readingTime(post.body)} min</span>
						{post.data.draft && <span class="draft">rascunho</span>}
					</div>
					<h3 class="title">
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</h3>
					<p class="desc">{post.data.description}</p>
				</article>
			</li>
		))
	}
</ol>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		border-top: 1px solid var(--border);
	}
	li:last-child {
		border-bottom: 1px solid var(--border);
	}
	article {
		position: relative;
		padding-block: 1.6rem;
	}
	.meta {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		color: var(--muted);
		margin-bottom: 0.5rem;
	}
	.draft {
		margin-left: 0.25rem;
		padding: 0 0.4rem;
		border-radius: 3px;
		background: var(--accent-soft);
		color: var(--accent);
	}
	.title {
		font-size: 1.45rem;
		line-height: 1.25;
	}
	.title a {
		text-decoration: none;
	}
	/* A área inteira do item é clicável, mantendo um único link acessível */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	article:hover .title a {
		color: var(--accent);
	}
	.desc {
		margin: 0.45rem 0 0;
		color: var(--muted);
		font-size: 0.975rem;
		line-height: 1.55;
		max-width: 60ch;
	}
</style>
