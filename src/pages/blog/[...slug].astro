---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, readingTime, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	// posts está do mais novo ao mais antigo: "anterior" = mais antigo, "próximo" = mais novo
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, prev: posts[i + 1], next: posts[i - 1] },
	}));
}

interface Props {
	post: Post;
	prev?: Post;
	next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost data={post.data} minutes={readingTime(post.body)} prev={prev} next={next}>
	<Content />
</BlogPost>
